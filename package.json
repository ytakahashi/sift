{
  "name": "@ytakahashi/sift",
  "productName": "Sift",
  "description": "A lightweight local diff viewer for inspecting changes with agent-aware ephemeral notes.",
  "version": "0.4.0",
  "author": "ytakahashi",
  "bin": {
    "sift": "dist/cli/index.js"
  },
  "bugs": {
    "url": "https://github.com/ytakahashi/sift/issues"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/server": "2.0.0",
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "hono": "4.13.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hono/vite-dev-server": "0.26.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.1.2",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.1.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "lucide-react": "1.28.0",
    "prettier": "3.9.6",
    "prismjs": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist/cli/index.js",
    "dist/client"
  ],
  "homepage": "https://github.com/ytakahashi/sift#readme",
  "keywords": [
    "diff",
    "git",
    "viewer"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ytakahashi/sift.git"
  },
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:server && pnpm run build:electron",
    "build:client": "vite build",
    "build:electron": "esbuild src/entrypoints/electron/main.ts --bundle --platform=node --format=esm --outdir=dist/electron --external:electron && esbuild src/entrypoints/electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist/electron/preload.cjs --external:electron",
    "build:mac": "pnpm run build && electron-builder --mac --publish never",
    "build:mac:dev": "pnpm run build && electron-builder --mac --dir -c electron-builder.dev.yml",
    "build:npm": "pnpm run build:client && pnpm run build:server",
    "build:server": "esbuild src/entrypoints/cli/index.ts --bundle --platform=node --format=esm --outdir=dist/cli --packages=external --banner:js=\"#!/usr/bin/env node\"",
    "dev": "vite",
    "dev:cli": "pnpm run build:client && tsx src/entrypoints/cli/index.ts",
    "electron:dev": "pnpm run build:client && pnpm run build:electron && electron dist/electron/main.js",
    "format": "prettier --check \"{src/**/*.{ts,tsx,css},*.{js,ts}}\"",
    "format:fix": "prettier --write \"{src/**/*.{ts,tsx,css},*.{js,ts}}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package:check": "npm pack --dry-run --json --ignore-scripts | node scripts/check-tarball.mjs",
    "prepack": "pnpm run build:npm",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.node.json && tsc --noEmit --project tsconfig.electron.json"
  },
  "type": "module"
}
