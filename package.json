{
  "name": "@ytakahashi/sift",
  "description": "Sift before you commit. A lightweight local diff viewer.",
  "version": "0.1.0",
  "author": "ytakahashi",
  "bin": {
    "sift": "./dist/cli/index.js"
  },
  "bugs": {
    "url": "https://github.com/ytakahashi/sift/issues"
  },
  "dependencies": {
    "@clack/prompts": "1.6.0",
    "@hono/node-server": "2.0.5",
    "@modelcontextprotocol/server": "2.0.0-beta.4",
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "hono": "4.12.25",
    "lucide-react": "1.20.0",
    "prismjs": "1.30.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hono/vite-dev-server": "0.26.0",
    "@modelcontextprotocol/client": "2.0.0-beta.4",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.9.3",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "42.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "prettier": "3.8.4",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist/cli/index.js",
    "dist/client"
  ],
  "homepage": "https://github.com/ytakahashi/sift#readme",
  "keywords": [
    "diff",
    "git",
    "viewer"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ytakahashi/sift.git"
  },
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:server && pnpm run build:electron",
    "build:client": "vite build",
    "build:electron": "esbuild src/entrypoints/electron/main.ts --bundle --platform=node --format=esm --outdir=dist/electron --external:electron && esbuild src/entrypoints/electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist/electron/preload.cjs --external:electron",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:mac:dev": "pnpm run build && electron-builder --mac --dir -c electron-builder.dev.yml",
    "build:npm": "pnpm run build:client && pnpm run build:server",
    "build:server": "esbuild src/entrypoints/cli/index.ts --bundle --platform=node --format=esm --outdir=dist/cli --packages=external --banner:js=\"#!/usr/bin/env node\"",
    "dev": "vite",
    "dev:cli": "pnpm run build:client && tsx src/entrypoints/cli/index.ts",
    "electron:dev": "pnpm run build:client && pnpm run build:electron && electron dist/electron/main.js",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package:check": "npm pack --dry-run --cache .npm",
    "prepack": "pnpm run build:npm",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.node.json && tsc --noEmit --project tsconfig.electron.json"
  },
  "type": "module"
}
